DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# SQL Server 2000 仅支持 TDS 7.1，当前实例不支持加密。
SQLSERVER_ENCRYPT=false
SQLSERVER_TDS_VERSION=7_1
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=15000
SQLSERVER_POOL_MAX=5
SQLSERVER_POOL_IDLE_TIMEOUT_MS=30000
API_PORT=8787
# 本地只运行 Vite、并把 /api 转发到远程服务时设置为 false。
START_LOCAL_API=true
API_PROXY_TARGET=http://127.0.0.1:8787
# npm run dev 会自动启用开发身份接口；生产环境不要设置为 development/true。
APP_ENV=production
ENABLE_DEV_AUTH=false
STATIC_DIR=dist
MAX_REQUEST_BODY_BYTES=16777216
CORS_ORIGIN=*
OCR_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
JWT_SECRET=
DINGTALK_CORP_ID=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 只在服务端使用。钉钉组织映射存储在 dingtalk_*_mappings 表中，不能放在 VITE_* 变量。
VITE_DINGTALK_CORP_ID=
VITE_DINGTALK_CLIENT_ID=
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
